# Copy to .env.test.local (gitignored) and fill in values from the TEST
# Supabase project — never the production project (ref fuccfnewtfwgdcofijmz).
# The RLS and load scripts refuse to run when the URL points at production.

# Project Settings → API
TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string (URI, "Session pooler").
# Used only to apply the schema and migrations to the test project.
TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
